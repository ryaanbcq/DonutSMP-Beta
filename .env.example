# Discord
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
# Role donne aux comptes verifies (optionnel)
VERIFIED_ROLE_ID=
# Salon ou sont logues les liens et les vouches (optionnel)
LOG_CHANNEL_ID=

# Compte Minecraft qui encaisse les micro-paiements de verification.
# NE PAS reutiliser le compte du casino (OutmindCompany) : un paiement de link
# serait relu comme un depot joueur si l'auto-depot est rallume.
MC_LINK_ACCOUNT=OutmindFR

# Source des paiements vus en jeu.
# jsonl  : le bot mineflayer append une ligne JSON par paiement recu
# mock   : rien, on injecte a la main avec npm run pay (dev local)
PAYMENT_SOURCE=jsonl
PAYMENT_FILE=./data/payments.jsonl

# Fenetre de validite d'un challenge de link, en minutes
LINK_TTL_MINUTES=15
LINK_AMOUNT_MIN=1
LINK_AMOUNT_MAX=1000

# API DonutSMP officielle (cle recuperee en jeu avec /api). Vide = mode mock.
DONUT_API_KEY=
DONUT_API_BASE=https://api.donutsmp.net/v1

# ---- Bot en jeu (ingame/bot.js) ----
# Compte Microsoft du compte receveur. Le pseudo en jeu doit correspondre
# a MC_LINK_ACCOUNT, le bot previent au demarrage si ce n est pas le cas.
MC_EMAIL=
MC_AUTH=microsoft
MC_HOST=donutsmp.net
MC_PORT=25565
# Vide = mineflayer detecte la version du serveur
MC_VERSION=
INGAME_STATUS=./data/ingame-status.json
