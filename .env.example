# Discord
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
# Role donne aux comptes verifies (optionnel)
VERIFIED_ROLE_ID=
# Salon ou sont logues les liens et les vouches (optionnel)
LOG_CHANNEL_ID=
# Tickets : intent privilegie « Message Content ». A COCHER dans le portail
# developpeur (Bot > Privileged Gateway Intents) avant de passer a true, sinon
# Discord refuse la connexion. Sans lui les transcripts n ont pas le texte.
DISCORD_MESSAGE_CONTENT=false

# Compte Minecraft qui encaisse les micro-paiements de verification.
# NE PAS reutiliser le compte du casino (OutmindCompany) : un paiement de link
# serait relu comme un depot joueur si l'auto-depot est rallume.
MC_LINK_ACCOUNT=OutmindFR

# Source des paiements vus en jeu.
# jsonl  : le bot mineflayer append une ligne JSON par paiement recu
# mock   : rien, on injecte a la main avec npm run pay (dev local)
PAYMENT_SOURCE=jsonl
PAYMENT_FILE=./data/payments.jsonl

# Fenetre de validite d'un challenge de link, en minutes
LINK_TTL_MINUTES=15
LINK_AMOUNT_MIN=1
LINK_AMOUNT_MAX=1000

# API DonutSMP officielle (cle recuperee en jeu avec /api). Vide = mode mock.
DONUT_API_KEY=
DONUT_API_BASE=https://api.donutsmp.net/v1

# ---- Bot en jeu (ingame/bot.js) ----
# Compte Microsoft du compte receveur. Le pseudo en jeu doit correspondre
# a MC_LINK_ACCOUNT, le bot previent au demarrage si ce n est pas le cas.
MC_EMAIL=
MC_AUTH=microsoft
MC_HOST=donutsmp.net
MC_PORT=25565
# Vide = mineflayer detecte la version du serveur
MC_VERSION=
INGAME_STATUS=./data/ingame-status.json
# Cache du jeton Microsoft, partage entre scripts/auth.js et ingame/bot.js
MC_PROFILES_FOLDER=./data/msa-cache

# Logo des embeds. Vide = avatar du bot (recommande). Ne pas coller une URL
# d attachement Discord : elle est signee et expire au bout de 24 h.
LOGO_URL=

# ---- Remboursement des micro-paiements ----
# Le paiement de verification est rendu au joueur 1 a 2 min plus tard.
REFUND_ENABLED=true
REFUND_FILE=./data/refunds.json
REFUND_DELAY_MIN_S=60
REFUND_DELAY_MAX_S=120
# Confirmation attendue avant de renvoyer un /pay
REFUND_CONFIRM_S=90
# Garde-fou : total rendu par jour, au dela le bot arrete et loggue
REFUND_DAILY_MAX=200000
# Le bot demande la cle API avec /api au demarrage si elle manque
DONUT_KEY_FETCH=true

# ---- Classement de la commu ----
# Duree visee pour interroger tous les membres verifies une fois.
BALTOP_CYCLE_MINUTES=15
# Plafond de securite (l API DonutSMP autorise 250 req/min)
BALTOP_MAX_PER_MINUTE=60
# Ces trois valeurs sont posees par /panel et retenues en base : les laisser
# vides est normal. Elles ne servent que de valeur de depart.
BALTOP_CHANNEL_ID=
# Intervalle minimum entre deux reecritures du panneau public
BALTOP_MIN_EDIT_SECONDS=120
# Role donne au premier du classement (retire a l ancien premier)
BALTOP_TOP_ROLE_ID=
# Salon ou est publie le panneau de connexion, cite dans le classement
LINK_CHANNEL_ID=
# Emojis du podium. Vides = medailles Unicode. Format : <a:nom:id> ou <:nom:id>
BALTOP_EMOJI_1=
BALTOP_EMOJI_2=
BALTOP_EMOJI_3=
# Donnees inventees pour developper sans cle API. Ne JAMAIS activer en prod :
# le classement publierait de faux soldes.
DONUT_MOCK=false

# ---- Releve des soldes en jeu ----
# DonutSMP n a pas d API accessible : les soldes se lisent avec /balance.
BALANCE_POLL=true
TRACKED_FILE=./data/tracked.json
BALANCE_FILE=./data/balances.jsonl
# Espacement entre deux /balance, en secondes (anti-spam)
BALANCE_INTERVAL_S=5
BALANCE_TIMEOUT_S=10
# Duree visee pour relever tout le monde une fois
BALANCE_CYCLE_MINUTES=15
BALANCE_FILE_MAX_MB=5
BALANCE_PRIORITY_FILE=./data/balance-priority.txt
STATS_PRIORITY_FILE=./data/stats-priority.txt
STATS_FILE=./data/stats.jsonl
